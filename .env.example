# คัดลอกเป็น .env.development.local แล้วเติมค่าจริง — ไฟล์นั้นไม่เข้า git

# Neon Postgres (ใช้ pooled connection string)
DATABASE_URL=

# Better Auth — สร้างด้วย: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3450
NEXT_PUBLIC_APP_URL=http://localhost:3450

# Google OAuth — ต้องลงทะเบียน redirect URI ให้ครบทุกโดเมนที่ใช้
#   http://localhost:3450/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob — ต้องมีสอง store คนละโหมด access เพราะเปลี่ยนทีหลังไม่ได้
#   public  = รูปหน้าร้าน อวาตาร์ ผลงาน หน้าปกเมนู
#   private = ไฟล์ส่งมอบ WIP สลิปโอนเงิน
# ตรวจด้วย: pnpm blob:check
BLOB_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=

# Resend — ส่งได้เฉพาะอีเมลเจ้าของบัญชีจนกว่าจะยืนยันโดเมน
RESEND_API_KEY=
# EMAIL_FROM=com-mi <noreply@yourdomain>

# เบอร์ PromptPay สำหรับทดสอบในเครื่องเท่านั้น — ห้ามใส่เบอร์จริงลงในโค้ด
DEV_TEST_PROMPTPAY_ID=
