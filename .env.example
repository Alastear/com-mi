# คัดลอกเป็น .env.development.local แล้วเติมค่าจริง — ไฟล์นั้นไม่เข้า git

# ระบุสภาพแวดล้อมให้ชัด — SITE_NOINDEX ไม่ได้ยืนยันว่าข้อมูลแยกจาก production
APP_ENV=development

# Neon Postgres (ใช้ pooled connection string)
DATABASE_URL=

# Better Auth — สร้างด้วย: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3450
NEXT_PUBLIC_APP_URL=http://localhost:3450

# Google OAuth — ต้องลงทะเบียน redirect URI ให้ครบทุกโดเมนที่ใช้
#   http://localhost:3450/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 — สองถัง สองกุญแจ (แต่ละกุญแจผูกได้ถังเดียว) ขาดตัวไหนอัป/โหลดไฟล์ไม่ได้เลย
#   public  = รูปหน้าร้าน อวาตาร์ ผลงาน หน้าปกเมนู — เปิดตรงจาก R2_PUBLIC_BASE_URL
#   private = ไฟล์ส่งมอบ — ไม่มีโดเมน ไม่เปิด r2.dev โหลดได้ผ่าน URL ที่เซ็นเท่านั้น
# ตรวจด้วย: pnpm r2:check (ข้อที่สคริปต์ตรวจไม่ได้อยู่ใน docs/01-architecture.md §5)
R2_ACCOUNT_ID=
R2_PUBLIC_BUCKET=
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
# ไม่มี / ท้าย
R2_PUBLIC_BASE_URL=
R2_PRIVATE_BUCKET=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=

# Vercel Blob (ของเก่า) — ใช้เฉพาะ scripts/migrate-blob-to-r2.mts (pnpm storage:migrate)
# แอปไม่อ่านสองตัวนี้แล้ว ลบทิ้งได้เมื่อย้ายไฟล์ครบและลบ Blob store แล้ว
BLOB_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=

# Resend — ส่งได้เฉพาะอีเมลเจ้าของบัญชีจนกว่าจะยืนยันโดเมน
RESEND_API_KEY=
# ผู้ส่งอีเมล — **ตั้งค่านี้คือสวิตช์เปิดล็อกอินด้วยอีเมล/รหัสผ่านและ OTP ทั้งชุด**
# ตั้งได้ต่อเมื่อยืนยันโดเมนกับ Resend แล้ว ไม่งั้นอีเมลจะส่งถึงเฉพาะเจ้าของบัญชี Resend
# และคนสมัครจะรอรหัสที่ไม่มีวันมาถึง (ดู lib/auth.ts → emailReady)
# EMAIL_FROM=com-mi <noreply@com-mi.poruyrai.xyz>

# เบอร์ PromptPay สำหรับทดสอบในเครื่องเท่านั้น — ห้ามใส่เบอร์จริงลงในโค้ด
DEV_TEST_PROMPTPAY_ID=

# ยังเป็นรุ่นทดสอบอยู่ — ส่ง X-Robots-Tag: noindex ทุกหน้า และไม่ประกาศ sitemap
# ลบออกแล้ว deploy คือการ "เปิดจริง" ให้ Google เก็บเข้าดัชนีได้
SITE_NOINDEX=1

# ป้องกัน endpoint งานรายวัน — สร้าง secret แยกจาก auth และตั้งใน deployment
# ไม่เรียก cleanup กับ production เพื่อทดสอบ ให้ใช้ staging และ dry=1
CRON_SECRET=
