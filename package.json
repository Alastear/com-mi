{
  "name": "commission-webpage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3450",
    "build": "next build",
    "start": "next start --port 3450",
    "lint": "eslint",
    "db:generate": "dotenv -e .env.development.local -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.development.local -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.development.local -e .env.local -- drizzle-kit studio",
    "db:check": "dotenv -e .env.development.local -e .env.local -- tsx scripts/check-db.mts",
    "db:seed-session": "dotenv -e .env.development.local -e .env.local -- tsx scripts/seed-test-session.mts",
    "db:clean-session": "dotenv -e .env.development.local -e .env.local -- tsx scripts/seed-test-session.mts --clean",
    "db:stats": "dotenv -e .env.development.local -e .env.local -- tsx scripts/db-stats.mts",
    "blob:check": "dotenv -e .env.development.local -e .env.local -- tsx scripts/blob-check.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.7.0",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "thumbhash": "^0.1.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
